{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team-workspace.local/schemas/adapter/v0/manifest.json",
  "title": "AI Team Workspace Adapter Manifest V0",
  "$defs": {
    "semver": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    }
  },
  "type": "object",
  "required": [
    "adapter_id",
    "name",
    "adapter_version",
    "protocol_versions",
    "harness_type",
    "entrypoint",
    "platforms",
    "capabilities",
    "auth_modes"
  ],
  "properties": {
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "adapter_version": {
      "$ref": "#/$defs/semver"
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/semver"
      }
    },
    "harness_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "entrypoint": {
      "type": "object",
      "required": ["executable", "args"],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        }
      },
      "additionalProperties": false
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["macos-aarch64", "macos-x86_64", "linux-x86_64", "linux-aarch64", "windows-x86_64"]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "health.check",
          "run.start",
          "run.status",
          "run.cancel",
          "run.reconcile",
          "run.output.streaming",
          "session.resume"
        ]
      }
    },
    "auth_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["none", "credential_reference", "native_session"]
      }
    },
    "configuration_schema": {
      "type": ["object", "null"]
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
