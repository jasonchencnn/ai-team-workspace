{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team-workspace.local/schemas/adapter/v0/message.json",
  "title": "AI Team Workspace Adapter JSON-RPC Message V0",
  "x-maxJsonUtf8Bytes": 1048576,
  "oneOf": [
    { "$ref": "#/$defs/initializeRequest" },
    { "$ref": "#/$defs/healthCheckRequest" },
    { "$ref": "#/$defs/runStartRequest" },
    { "$ref": "#/$defs/runStatusRequest" },
    { "$ref": "#/$defs/runCancelRequest" },
    { "$ref": "#/$defs/runReconcileRequest" },
    { "$ref": "#/$defs/shutdownRequest" },
    { "$ref": "#/$defs/heartbeatNotification" },
    { "$ref": "#/$defs/outputNotification" },
    { "$ref": "#/$defs/completedNotification" },
    { "$ref": "#/$defs/failedNotification" },
    { "$ref": "#/$defs/successResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "rpcId": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 128 },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "reference": {
      "type": "object",
      "required": ["kind", "uri"],
      "properties": {
        "kind": {
          "enum": [
            "workspace_file",
            "workspace_anchor",
            "git_commit",
            "git_diff",
            "report",
            "artifact",
            "controlled_url"
          ]
        },
        "uri": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "version": { "type": ["string", "null"], "maxLength": 256 },
        "checksum": { "type": ["string", "null"], "maxLength": 256 },
        "media_type": { "type": ["string", "null"], "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "artifactReference": {
      "allOf": [
        { "$ref": "#/$defs/reference" },
        {
          "properties": {
            "kind": { "const": "artifact" }
          }
        }
      ]
    },
    "runContext": {
      "type": "object",
      "required": [
        "team_id",
        "task_id",
        "run_id",
        "role_id",
        "binding_id",
        "binding_version",
        "fencing_token"
      ],
      "properties": {
        "team_id": { "$ref": "#/$defs/uuid" },
        "task_id": { "$ref": "#/$defs/uuid" },
        "run_id": { "$ref": "#/$defs/uuid" },
        "role_id": { "$ref": "#/$defs/uuid" },
        "binding_id": { "$ref": "#/$defs/uuid" },
        "binding_version": { "type": "integer", "minimum": 1 },
        "fencing_token": { "type": "integer", "minimum": 1 }
      }
    },
    "runEventContext": {
      "allOf": [
        { "$ref": "#/$defs/runContext" },
        {
          "type": "object",
          "required": ["sequence"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "initializeRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/rpcId" },
        "method": { "const": "initialize" },
        "params": {
          "type": "object",
          "required": [
            "protocol_version",
            "application_version",
            "harness_instance_id",
            "platform",
            "locale",
            "correlation_id"
          ],
          "properties": {
            "protocol_version": { "$ref": "#/$defs/semver" },
            "application_version": { "type": "string", "minLength": 1, "maxLength": 64 },
            "harness_instance_id": { "$ref": "#/$defs/uuid" },
            "platform": {
              "enum": [
                "macos-aarch64",
                "macos-x86_64",
                "linux-x86_64",
                "linux-aarch64",
                "windows-x86_64"
              ]
            },
            "locale": { "type": "string", "minLength": 2, "maxLength": 32 },
            "configuration_generation": { "type": "integer", "minimum": 1 },
            "credential_references": {
              "type": "array",
              "maxItems": 16,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "correlation_id": { "$ref": "#/$defs/uuid" },
            "extensions": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "healthCheckRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/rpcId" },
        "method": { "const": "health.check" },
        "params": {
          "type": "object",
          "required": ["correlation_id"],
          "properties": {
            "correlation_id": { "$ref": "#/$defs/uuid" },
            "include_diagnostics": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runStartRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/rpcId" },
        "method": { "const": "run.start" },
        "params": {
          "allOf": [
            { "$ref": "#/$defs/runContext" },
            {
              "type": "object",
              "required": [
                "idempotency_key",
                "task_title",
                "role_name",
                "role_instructions",
                "references",
                "shared_workspace_root",
                "execution_workspace_root",
                "read_scopes",
                "write_scopes",
                "heartbeat_interval_ms",
                "timeout_ms",
                "correlation_id"
              ],
              "properties": {
                "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 },
                "task_title": { "type": "string", "minLength": 1, "maxLength": 300 },
                "role_name": { "type": "string", "minLength": 1, "maxLength": 120 },
                "role_instructions": { "type": "string", "minLength": 1, "maxLength": 32768 },
                "references": {
                  "type": "array",
                  "maxItems": 128,
                  "items": { "$ref": "#/$defs/reference" }
                },
                "shared_workspace_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "execution_workspace_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "read_scopes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                },
                "write_scopes": {
                  "type": "array",
                  "maxItems": 128,
                  "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                },
                "verification_commands": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "required": ["program", "args"],
                    "properties": {
                      "program": { "type": "string", "minLength": 1, "maxLength": 1024 },
                      "args": {
                        "type": "array",
                        "maxItems": 64,
                        "items": { "type": "string", "maxLength": 2048 }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "credential_references": {
                  "type": "array",
                  "maxItems": 16,
                  "items": { "type": "string", "minLength": 1, "maxLength": 256 }
                },
                "heartbeat_interval_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
                "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 604800000 },
                "max_output_bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
                "correlation_id": { "$ref": "#/$defs/uuid" },
                "extensions": { "type": "object" }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": false
    },
    "runStatusRequest": {
      "$ref": "#/$defs/simpleRunRequest",
      "description": "Use method run.status"
    },
    "runCancelRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/rpcId" },
        "method": { "const": "run.cancel" },
        "params": {
          "allOf": [
            { "$ref": "#/$defs/runContext" },
            {
              "type": "object",
              "required": ["reason", "requested_at", "correlation_id"],
              "properties": {
                "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "requested_at": { "$ref": "#/$defs/timestamp" },
                "force_after_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 300000 },
                "correlation_id": { "$ref": "#/$defs/uuid" }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": false
    },
    "runReconcileRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/rpcId" },
        "method": { "const": "run.reconcile" },
        "params": {
          "allOf": [
            { "$ref": "#/$defs/runContext" },
            {
              "type": "object",
              "required": ["last_known_sequence", "correlation_id"],
              "properties": {
                "last_known_sequence": { "type": "integer", "minimum": 0 },
                "session_reference": { "type": ["string", "null"], "maxLength": 2048 },
                "correlation_id": { "$ref": "#/$defs/uuid" }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": false
    },
    "simpleRunRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/rpcId" },
        "method": { "const": "run.status" },
        "params": {
          "allOf": [
            { "$ref": "#/$defs/runContext" },
            {
              "type": "object",
              "required": ["correlation_id"],
              "properties": {
                "correlation_id": { "$ref": "#/$defs/uuid" }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": false
    },
    "shutdownRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/rpcId" },
        "method": { "const": "adapter.shutdown" },
        "params": {
          "type": "object",
          "required": ["reason", "correlation_id"],
          "properties": {
            "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
            "grace_period_ms": { "type": "integer", "minimum": 0, "maximum": 300000 },
            "correlation_id": { "$ref": "#/$defs/uuid" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "heartbeatNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "run.heartbeat" },
        "params": {
          "allOf": [
            { "$ref": "#/$defs/runEventContext" },
            {
              "type": "object",
              "required": ["observed_at", "phase"],
              "properties": {
                "observed_at": { "$ref": "#/$defs/timestamp" },
                "phase": { "type": "string", "minLength": 1, "maxLength": 120 },
                "progress_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": false
    },
    "outputNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "run.output" },
        "params": {
          "allOf": [
            { "$ref": "#/$defs/runEventContext" },
            {
              "type": "object",
              "required": ["observed_at", "kind"],
              "properties": {
                "observed_at": { "$ref": "#/$defs/timestamp" },
                "kind": { "enum": ["stdout", "stderr", "progress", "artifact_candidate"] },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536,
                  "x-maxUtf8Bytes": 65536
                },
                "artifact": { "$ref": "#/$defs/artifactReference" },
                "truncated": { "type": "boolean", "default": false }
              },
              "oneOf": [
                {
                  "properties": {
                    "kind": { "enum": ["stdout", "stderr", "progress"] }
                  },
                  "required": ["content"],
                  "not": { "required": ["artifact"] }
                },
                {
                  "properties": {
                    "kind": { "const": "artifact_candidate" }
                  },
                  "required": ["artifact"],
                  "not": { "required": ["content"] }
                }
              ]
            }
          ],
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": false
    },
    "completedNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "run.completed" },
        "params": {
          "allOf": [
            { "$ref": "#/$defs/runEventContext" },
            {
              "type": "object",
              "required": ["completed_at", "result_references"],
              "properties": {
                "completed_at": { "$ref": "#/$defs/timestamp" },
                "result_references": {
                  "type": "array",
                  "maxItems": 128,
                  "items": { "$ref": "#/$defs/reference" }
                },
                "summary": { "type": ["string", "null"], "maxLength": 8000 }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": false
    },
    "failedNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "run.failed" },
        "params": {
          "allOf": [
            { "$ref": "#/$defs/runEventContext" },
            {
              "type": "object",
              "required": ["failed_at", "error_class", "code", "retryable"],
              "properties": {
                "failed_at": { "$ref": "#/$defs/timestamp" },
                "error_class": {
                  "enum": [
                    "transient",
                    "authentication",
                    "capability",
                    "permission",
                    "context",
                    "execution",
                    "timeout",
                    "cancelled",
                    "protocol",
                    "internal"
                  ]
                },
                "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
                "retryable": { "type": "boolean" },
                "reason_key": { "type": ["string", "null"], "maxLength": 128 },
                "diagnostic_reference": {
                  "oneOf": [{ "$ref": "#/$defs/reference" }, { "type": "null" }]
                }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": false
    },
    "initializeResult": {
      "type": "object",
      "required": [
        "kind",
        "protocol_version",
        "adapter_version",
        "capabilities",
        "auth_status",
        "isolation_mode",
        "recovery_mode"
      ],
      "properties": {
        "kind": { "const": "initialize" },
        "protocol_version": { "$ref": "#/$defs/semver" },
        "adapter_version": { "$ref": "#/$defs/semver" },
        "harness_version": { "type": ["string", "null"], "maxLength": 128 },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "auth_status": { "enum": ["not_required", "ready", "missing", "invalid", "expired"] },
        "isolation_mode": { "enum": ["process", "config_directory", "container", "external"] },
        "recovery_mode": { "enum": ["none", "status_query", "session_resume"] },
        "extensions": { "type": "object" }
      },
      "additionalProperties": false
    },
    "healthResult": {
      "type": "object",
      "required": ["kind", "status", "checked_at", "diagnostic_codes"],
      "properties": {
        "kind": { "const": "health" },
        "status": { "enum": ["healthy", "degraded", "unavailable", "auth_failed", "incompatible"] },
        "checked_at": { "$ref": "#/$defs/timestamp" },
        "diagnostic_codes": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
        },
        "details_reference": {
          "oneOf": [{ "$ref": "#/$defs/reference" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "runStartResult": {
      "type": "object",
      "required": ["kind", "accepted", "observed_at"],
      "properties": {
        "kind": { "const": "run_start" },
        "accepted": { "type": "boolean" },
        "session_reference": { "type": ["string", "null"], "maxLength": 2048 },
        "observed_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "runStatusResult": {
      "type": "object",
      "required": ["kind", "status", "last_sequence", "observed_at"],
      "properties": {
        "kind": { "const": "run_status" },
        "status": {
          "enum": [
            "queued",
            "starting",
            "running",
            "succeeded",
            "failed",
            "timed_out",
            "cancelled",
            "unknown",
            "not_found"
          ]
        },
        "last_sequence": { "type": "integer", "minimum": 0 },
        "session_reference": { "type": ["string", "null"], "maxLength": 2048 },
        "observed_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "runCancelResult": {
      "type": "object",
      "required": ["kind", "accepted", "confirmed", "observed_at"],
      "properties": {
        "kind": { "const": "run_cancel" },
        "accepted": { "type": "boolean" },
        "confirmed": { "type": "boolean" },
        "observed_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "runReconcileResult": {
      "type": "object",
      "required": ["kind", "status", "last_sequence", "observed_at", "result_references"],
      "properties": {
        "kind": { "const": "run_reconcile" },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "timed_out",
            "cancelled",
            "unknown",
            "not_found"
          ]
        },
        "last_sequence": { "type": "integer", "minimum": 0 },
        "session_reference": { "type": ["string", "null"], "maxLength": 2048 },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "result_references": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/reference" }
        },
        "failure_code": { "type": ["string", "null"], "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "shutdownResult": {
      "type": "object",
      "required": ["kind", "accepted"],
      "properties": {
        "kind": { "const": "shutdown" },
        "accepted": { "type": "boolean" },
        "remaining_run_ids": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/uuid" }
        }
      },
      "additionalProperties": false
    },
    "successResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/rpcId" },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/initializeResult" },
            { "$ref": "#/$defs/healthResult" },
            { "$ref": "#/$defs/runStartResult" },
            { "$ref": "#/$defs/runStatusResult" },
            { "$ref": "#/$defs/runCancelResult" },
            { "$ref": "#/$defs/runReconcileResult" },
            { "$ref": "#/$defs/shutdownResult" }
          ]
        }
      },
      "additionalProperties": false
    },
    "standardErrorResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": {
          "oneOf": [{ "$ref": "#/$defs/rpcId" }, { "type": "null" }]
        },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "enum": [-32700, -32600, -32601, -32602, -32603] },
            "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "data": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "customErrorResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": {
          "oneOf": [{ "$ref": "#/$defs/rpcId" }, { "type": "null" }]
        },
        "error": {
          "type": "object",
          "required": ["code", "message", "data"],
          "properties": {
            "code": {
              "enum": [
                -32010, -32011, -32012, -32013, -32014, -32015, -32016, -32017, -32018, -32099
              ]
            },
            "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "data": {
              "type": "object",
              "properties": {
                "domain_code": {
                  "enum": [
                    "ADAPTER_INCOMPATIBLE",
                    "ADAPTER_CAPABILITY_MISSING",
                    "ADAPTER_AUTHENTICATION_FAILED",
                    "BINDING_STALE_VERSION",
                    "RUN_FENCED",
                    "RUN_OUTPUT_OUT_OF_ORDER",
                    "WORKSPACE_PATH_OUTSIDE_SCOPE",
                    "ADAPTER_UNAVAILABLE",
                    "CONCURRENCY_IDEMPOTENCY_CONFLICT",
                    "ADAPTER_PROTOCOL_VIOLATION"
                  ]
                },
                "retryable": { "type": "boolean" },
                "correlation_id": { "$ref": "#/$defs/uuid" },
                "reason_key": { "type": ["string", "null"], "maxLength": 128 }
              },
              "required": ["domain_code", "retryable", "correlation_id"],
              "additionalProperties": false
            }
          },
          "oneOf": [
            { "$ref": "#/$defs/customErrorIncompatible" },
            { "$ref": "#/$defs/customErrorCapabilityMissing" },
            { "$ref": "#/$defs/customErrorAuthenticationFailed" },
            { "$ref": "#/$defs/customErrorBindingStale" },
            { "$ref": "#/$defs/customErrorRunFenced" },
            { "$ref": "#/$defs/customErrorOutputOutOfOrder" },
