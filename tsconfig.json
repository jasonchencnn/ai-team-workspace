{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": [
    "eslint.config.mjs",
    "scripts/**/*.mjs",
    "scripts/**/*.d.mts",
    "packages/contracts-ts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
