{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Team Workspace",
  "version": "0.2.0",
  "identifier": "com.ai-team-workspace.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["main-window"]
    },
    "windows": [
      {
        "label": "main",
        "title": "AI Team Workspace",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI 团队协作工作台",
    "longDescription": "Teamspace：本地跑的 AI 团队协作工作台——团队、岗位、任务、执行、验收、消息与备份一体的桌面应用。",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
