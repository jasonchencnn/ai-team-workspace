{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Team Workspace",
  "version": "0.0.0",
  "identifier": "com.ai-team-workspace.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["main-window"]
    },
    "windows": [
      {
        "label": "main",
        "title": "AI Team Workspace",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
